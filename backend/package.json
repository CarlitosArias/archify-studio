{
  "name": "archify-studio-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend de Archify Studio: traduce JSON simple al spec de Archify y persiste diagramas en SQLite",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server.mjs",
    "start": "node --env-file-if-exists=.env server.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.1.0"
  }
}
